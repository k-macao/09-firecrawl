# 复制为 .env 后填入（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# Firecrawl 云端 Key（可选，但强烈推荐；不填则直抓兜底） https://firecrawl.dev
FIRECRAWL_API_KEY=
# 自建 Firecrawl 时改这里
FIRECRAWL_API_URL=https://api.firecrawl.dev
# PushPlus token（推微信必填） https://www.pushplus.plus 登录后在「一对一推送」获取，并微信扫码关注公众号
PUSHPLUS_TOKEN=
# 可选：PushPlus 群组编码（一对多推送时填）
PUSHPLUS_TOPIC=
